  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "hachi orchestrator successor-launch attest",
            "timeout": 10,
            "additionalContextLimit": 1024
          }
        ]
      }
    ]
  }
}
